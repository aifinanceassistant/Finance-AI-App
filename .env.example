# Web API origin — profile sync / onboarding (Bearer to Next.js routes).
# Simulator: http://localhost:3000 · Android emulator: http://10.0.2.2:3000 · Device: your LAN or deployed URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Auth (client SDK — direct)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (client-safe). Dashboard: Settings > API Keys > Publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Deep link for OAuth / magic-link / password-reset return. Register in Supabase Auth → URL config.
# Must match Android intent-filter + iOS CFBundleURLTypes (scheme financeai, host auth-callback).
NEXT_PUBLIC_MOBILE_AUTH_REDIRECT=financeai://auth-callback
